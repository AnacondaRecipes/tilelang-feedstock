From: Anaconda Inc. <maintainers@anaconda.com>
Subject: [PATCH] Respect a preset CMAKE_CUDA_COMPILER

conda's CUDA toolchain ships two nvcc entry points: the functional wrapper at
$BUILD_PREFIX/bin/nvcc (whose nvcc.profile locates cicc/nvvm) and a raw copy
under targets/<arch>/bin with a degenerate profile. FindCUDAToolkit resolves
CUDAToolkit_BIN_DIR to the raw copy, and the unconditional override here then
breaks CMake's CUDA compiler identification with `sh: cicc: command not found`.
Only apply the override when the builder did not already choose a compiler
(the recipe passes -DCMAKE_CUDA_COMPILER=$BUILD_PREFIX/bin/nvcc).

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -307,7 +307,9 @@
 elseif(USE_CUDA)
   set(CMAKE_CUDA_STANDARD 17)
   find_package(CUDAToolkit REQUIRED)
-  set(CMAKE_CUDA_COMPILER "${CUDAToolkit_BIN_DIR}/nvcc")
+  if(NOT CMAKE_CUDA_COMPILER)
+    set(CMAKE_CUDA_COMPILER "${CUDAToolkit_BIN_DIR}/nvcc")
+  endif()
   add_compile_definitions("CUDA_MAJOR_VERSION=${CUDAToolkit_VERSION_MAJOR}")
 
   # Set `USE_CUDA=/usr/local/cuda-x.y`
